# Hostinger (Apache/LiteSpeed) — application React à page unique
Options -MultiViews
RewriteEngine On

# Forcer HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Les fichiers et dossiers existants sont servis tels quels
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Toutes les autres routes (/produit/..., /admin, /order/...) → index.html
RewriteRule ^ index.html [L]

# Cache long pour les fichiers versionnés, pas de cache pour index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
